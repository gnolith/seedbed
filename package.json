{
  "name": "@gnolith/seedbed",
  "version": "0.4.0",
  "description": "Compose-first installer, migration, backup, adoption, and diagnostics control plane for Gnolith.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Gnolith contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/gnolith/seedbed.git"
  },
  "homepage": "https://github.com/gnolith/seedbed#readme",
  "bugs": {
    "url": "https://github.com/gnolith/seedbed/issues"
  },
  "keywords": [
    "gnolith",
    "installer",
    "compose",
    "backup"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "bin": {
    "seedbed": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./compose": {
      "types": "./dist/compose.d.ts",
      "import": "./dist/compose.js"
    },
    "./backup": {
      "types": "./dist/backup.d.ts",
      "import": "./dist/backup.js"
    },
    "./adoption": {
      "types": "./dist/adoption.d.ts",
      "import": "./dist/adoption.js"
    },
    "./local-control": {
      "types": "./dist/local-control.d.ts",
      "import": "./dist/local-control.js"
    }
  },
  "files": [
    "dist",
    "compose",
    "components",
    "docker",
    "docs",
    "examples",
    "fixtures",
    "seedbed-assembly-attestation.json",
    "seedbed-component-lock.json",
    "migration-order.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "SUPPORT.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:packed": "node scripts/packed-system-test.mjs",
    "test:compose": "node scripts/compose-qualification.mjs",
    "test:docker": "node scripts/local-docker-qualification.mjs",
    "test:legacy-docker": "node scripts/legacy-docker-qualification.mjs",
    "check:inventory": "node scripts/verify-inventory.mjs",
    "check:secrets": "node scripts/secret-canary.mjs",
    "check:legacy-fixture": "node scripts/verify-legacy-fixture.mjs",
    "check:examples": "node scripts/sync-example-from-lock.mjs --check",
    "sync:example": "node scripts/sync-example-from-lock.mjs --write",
    "check": "npm run typecheck && npm test && npm run build && npm run check:inventory && npm run check:examples && npm run check:secrets && npm run check:legacy-fixture && npm run security:runtime-check && npm run pack:check",
    "security:runtime-check": "node scripts/audit-zero.mjs --full && node scripts/audit-zero.mjs",
    "pack:check": "npm pack --dry-run",
    "candidate": "node scripts/candidate-handoff.mjs",
    "candidate:refresh-attestation": "node scripts/candidate-handoff.mjs --refresh-attestation",
    "prepack": "npm run build && npm run check:inventory && npm run check:examples"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@vitest/coverage-v8": "3.2.6",
    "typescript": "5.9.2",
    "vitest": "3.2.6",
    "yaml": "2.9.0"
  }
}
